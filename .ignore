# ripgrep (the search in Cursor, Claude Code and Codex, and their search panel) reads this file on top of .gitignore, so
# what Git holds back is hidden from search too; these lines hide what Git may keep but no search should wade through.
# Paths are written from the repo root. Hidden from search is not missing: a file is still read by its path.

# Secrets, also the example files Git may keep
.env*

# Caches
.pytest_cache/

# Models, binaries and lock files, wherever they land (Jakob 2026-11-18: "glb-modeller och andra stora filer ignoreras
# för att spara pengar")
*.bin
*.ply
*.ktx2
*.onnx
*.task
*.safetensors
*.wasm
package-lock.json

# avatar-auto-pipeline: the source lists of the cards and textures, machine-written addresses read by path
# (assets/bord/kort/kallor.json, assets/bord/texturer/kallor.json)
/avatar-auto-pipeline/assets/**/kallor.json

# blackjack-dealer: Git holds back assets/, but its small text (receipts, proof descriptions, generation records, prompts)
# should be searchable and its media not. So: bring the folder back, hide all in it, bring back only text.
!/blackjack-dealer/assets/
/blackjack-dealer/assets/**
!/blackjack-dealer/assets/**/
!/blackjack-dealer/assets/**/*.json
!/blackjack-dealer/assets/**/*.txt
!/blackjack-dealer/assets/**/*.md
# Machine data read by path by the tools that own it: the card tracks per frame, the speech lane's receipts per line,
# and the 3D dummy's motion data (numbers per frame)
/blackjack-dealer/assets/tracking/
/blackjack-dealer/assets/speech/
/blackjack-dealer/dealer3d/data/
# A proof's own machine data, each written as one long line (0.1 to 0.8 MB): the motion a dealer's film was made from
# and the measurement per frame. The proof's description (proof.json) and its calls stay searchable.
/blackjack-dealer/assets/**/rorelse.json
/blackjack-dealer/assets/**/matning-per-ruta.json
# The register of films and takes, one post per line (the working copy is a database under .runtime/). Read one post
# with `node tools/register.ts get <id>`, find posts with `node tools/register.ts list <text>`.
/blackjack-dealer/data/motions.jsonl
/blackjack-dealer/data/motions-removed.jsonl

# live-bj: the measured patterns of the two dealers as one long line (227 kB), everything they do cut into pieces and
# sorted into kinds, also one long line (125 kB), and the whole film cut per hand (one piece per line, 0.5 MB; read it
# by its path, or segment.py dela --visa <a> <b>); the small style files beside them (live-bj/data/stil-*.json) stay
# searchable
/live-bj/data/monster.json
/live-bj/data/rorelser.json
/live-bj/data/segment.json
# live-bj: the motions lifted out of the film (numbers per frame, up to 0.4 MB each) and the depth samples they rest on;
# read by path, for example live-bj/data/lyft/kameran-mitten-plats-4.json
/live-bj/data/lyft/
/live-bj/data/sam-prov/

# standarddocka: the motions' frames (numbers per frame, about 0.6 MB each), kept in Git and read by path, for example
# standarddocka/rorelser/a1-a23-p4c1.rutor.json
/standarddocka/rorelser/*.rutor.json
