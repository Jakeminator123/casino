# ripgrep (the search in Cursor, Claude Code and Codex) reads this file on top of .gitignore. These lines hide from
# search what Git may keep but no search should wade through, in every project; a project's own .ignore adds to this
# (blackjack-dealer/.ignore). Hidden from search is not missing: a file is still read by its path.

# The slask: temporary work of every project, emptied after a week (AGENTS.md, "Slasken"). Its tool slask/slask.ts is
# code and searchable; what lies in the project folders is not. `node slask/slask.ts` lists it, and a file there is read
# by its path.
/slask/*
!/slask/slask.ts

# avatar-auto-pipeline's photos, results and portable Blender (about 1.7 GB, read by path)
/avatar-auto-pipeline/input/
/avatar-auto-pipeline/output/
/avatar-auto-pipeline/tools/

# Secrets
.env*
private/
*.pem

# Environments, caches and build output
node_modules/
.venv/
venv/
__pycache__/
.next/
.pytest_cache/
*.pyc
*.log
