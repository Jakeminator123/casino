{
  "name": "dealer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "volta": {
    "node": "24.22.3"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 tools/*.test.ts studio/tests/*.test.ts dealer3d/tests/*.test.ts",
    "check": "node ../.githooks/check.ts",
    "hooks:install": "node ../.githooks/check.ts --install",
    "verify": "node tools/verify.ts",
    "start": "node --disable-warning=ExperimentalWarning tools/preview.ts --open",
    "status": "node --disable-warning=ExperimentalWarning tools/preview.ts --status",
    "stop": "node --disable-warning=ExperimentalWarning tools/preview.ts --stop",
    "stada": "node tools/scratch-clean.ts",
    "media:status": "node tools/media-status.ts",
    "gallra": "node tools/media-thin.ts"
  },
  "dependencies": {
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0"
  }
}
